# ==============================================================================
# Cyberium Academy CLI - Student Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your personal student session cookies.
# To find your cookies:
#   1. Open https://cyberium.academy in your browser and log in.
#   2. Press F12 -> Storage (or Application) -> Cookies -> https://cyberium.academy
# ==============================================================================

# Required session cookies:
CONNECT_SID="s%3A..."
CYB_RT="eyJhbGciOi..."

# Optional Cloudflare / verification cookies (if prompted):
CYB_TD=""
CFLB=""

# Optional track defaults:
CURRENT_PROGRAM_ID=10
CURRENT_MODULE_ID=88
