#!/usr/bin/env python3
import sys
import os

# Add parent directory to sys.path so package imports work directly
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))

from cyberium.cli import main

if __name__ == "__main__":
    main()
